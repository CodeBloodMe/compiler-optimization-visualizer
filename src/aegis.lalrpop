// =============================================================================
// AegisLang: Formal LR(1) Reference Grammar Specification (LALRPOP Draft)
// =============================================================================
//
// STATUS: Formal Reference Grammar (Non-Executable Draft)
//
// NOTE:
// This LALRPOP specification formally defines the canonical LR(1) grammar for
// AegisLang. In the production Aegis compiler pipeline, parsing is carried out
// by the recursive-descent parser (`src/parser.rs`), which provides rich span
// tracking, source diagnostics, and specialized syntax error recovery.
//
// This file serves as the normative specification for language productions,
// operator precedence, associativity, and AST node correspondence.
// =============================================================================

use crate::ast::*;
use crate::types::Type;
use crate::source::Span;

grammar;

pub Program: Program = {
    "module" <id:Ident> ";" <caps:CapabilityDecl*> <funcs:FunctionDecl*> => {
        Program {
            module_name: id,
            module_span: Span::point(1, 1),
            capabilities: caps,
            functions: funcs,
        }
    }
};

pub CapabilityDecl: CapabilityDecl = {
    "requires" <name:DottedIdent> ";" => {
        CapabilityDecl {
            name,
            span: Span::point(1, 1),
        }
    }
};

DottedIdent: String = {
    <id1:Ident> "." <id2:Ident> => format!("{}.{}", id1, id2),
    <id:Ident> => id,
};

pub FunctionDecl: FunctionDecl = {
    "fn" <name:Ident> "(" <params:Comma<Param>> ")" "->" <ret:Type> <b:Block> => {
        FunctionDecl {
            name,
            params,
            return_type: ret,
            body: b,
            span: Span::point(1, 1),
        }
    }
};

Param: Param = {
    <name:Ident> ":" <ty:Type> => Param { name, ty, span: Span::point(1, 1) }
};

pub Block: Block = {
    "{" <stmts:Statement*> "}" => Block {
        statements: stmts,
        span: Span::point(1, 1),
    }
};

Type: Type = {
    "i32" => Type::I32,
    "bool" => Type::Bool,
    "void" => Type::Void,
};

pub Statement: Statement = {
    "let" "mut" <name:Ident> <ty:(":" <Type>)?> "=" <init:Expr> ";" => {
        Statement::Let { name, is_mut: true, ty, init, span: Span::point(1, 1) }
    },
    "let" <name:Ident> <ty:(":" <Type>)?> "=" <init:Expr> ";" => {
        Statement::Let { name, is_mut: false, ty, init, span: Span::point(1, 1) }
    },
    <target:Ident> "=" <val:Expr> ";" => {
        Statement::Assign { target, value: val, span: Span::point(1, 1) }
    },
    "if" <cond:Expr> <then_b:Block> "else" <else_b:Block> => {
        Statement::If { cond, then_block: then_b, else_block: Some(else_b), span: Span::point(1, 1) }
    },
    "if" <cond:Expr> <then_b:Block> => {
        Statement::If { cond, then_block: then_b, else_block: None, span: Span::point(1, 1) }
    },
    "while" <cond:Expr> <body:Block> => {
        Statement::While { cond, body, span: Span::point(1, 1) }
    },
    "return" <val:Expr?> ";" => {
        Statement::Return { value: val, span: Span::point(1, 1) }
    },
    <e:Expr> ";" => {
        Statement::Expr(e)
    },
};

pub Expr: Expr = {
    LogicalOrExpr
};

LogicalOrExpr: Expr = {
    <lhs:LogicalOrExpr> "||" <rhs:LogicalAndExpr> => Expr::Binary {
        op: BinaryOp::Or,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    LogicalAndExpr,
};

LogicalAndExpr: Expr = {
    <lhs:LogicalAndExpr> "&&" <rhs:EqualityExpr> => Expr::Binary {
        op: BinaryOp::And,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    EqualityExpr,
};

EqualityExpr: Expr = {
    <lhs:EqualityExpr> "==" <rhs:RelationalExpr> => Expr::Binary {
        op: BinaryOp::Eq,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:EqualityExpr> "!=" <rhs:RelationalExpr> => Expr::Binary {
        op: BinaryOp::Neq,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    RelationalExpr,
};

RelationalExpr: Expr = {
    <lhs:RelationalExpr> "<" <rhs:AdditiveExpr> => Expr::Binary {
        op: BinaryOp::Lt,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:RelationalExpr> "<=" <rhs:AdditiveExpr> => Expr::Binary {
        op: BinaryOp::Lte,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:RelationalExpr> ">" <rhs:AdditiveExpr> => Expr::Binary {
        op: BinaryOp::Gt,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:RelationalExpr> ">=" <rhs:AdditiveExpr> => Expr::Binary {
        op: BinaryOp::Gte,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    AdditiveExpr,
};

AdditiveExpr: Expr = {
    <lhs:AdditiveExpr> "+" <rhs:MultiplicativeExpr> => Expr::Binary {
        op: BinaryOp::Add,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:AdditiveExpr> "-" <rhs:MultiplicativeExpr> => Expr::Binary {
        op: BinaryOp::Sub,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    MultiplicativeExpr,
};

MultiplicativeExpr: Expr = {
    <lhs:MultiplicativeExpr> "*" <rhs:UnaryExpr> => Expr::Binary {
        op: BinaryOp::Mul,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:MultiplicativeExpr> "/" <rhs:UnaryExpr> => Expr::Binary {
        op: BinaryOp::Div,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    <lhs:MultiplicativeExpr> "%" <rhs:UnaryExpr> => Expr::Binary {
        op: BinaryOp::Rem,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::point(1, 1),
    },
    UnaryExpr,
};

UnaryExpr: Expr = {
    "!" <e:UnaryExpr> => Expr::Unary {
        op: UnaryOp::Not,
        expr: Box::new(e),
        span: Span::point(1, 1),
    },
    "-" <e:UnaryExpr> => Expr::Unary {
        op: UnaryOp::Neg,
        expr: Box::new(e),
        span: Span::point(1, 1),
    },
    PrimaryExpr,
};

PrimaryExpr: Expr = {
    <n:IntLit> => Expr::Integer(n, Span::point(1, 1)),
    "true" => Expr::Boolean(true, Span::point(1, 1)),
    "false" => Expr::Boolean(false, Span::point(1, 1)),
    <id:Ident> => Expr::Variable(id, Span::point(1, 1)),
    <callee:Ident> "(" <args:Comma<Expr>> ")" => Expr::Call {
        callee,
        args,
        span: Span::point(1, 1),
    },
    "(" <e:Expr> ")" => e,
};

Comma<T>: Vec<T> = {
    <v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
};

Ident: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => String::from(<>);
IntLit: i64 = r"[0-9]+" => <>.parse::<i64>().unwrap();
